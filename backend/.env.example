# Copy to .env and fill in. .env is git-ignored: never commit it or paste its values anywhere.
# For DB integration tests, also copy to .env.test with NODE_ENV=test and DB_NAME=healthmarg_test.
# In production, set these as environment variables on the host instead of using a file.
# See docs/security.md and docs/database.md.
NODE_ENV=development
PORT=5000
# Comma-separated allow-list of frontend origins (must be https in production)
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL (users created by src/db/setup/create-db-users.sql) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthmarg
# Runtime user: least privilege, never root
DB_USER=healthmarg_app
DB_PASSWORD=
# Migration user: only used by npm run db:migrate and DB tests
DB_MIGRATOR_USER=healthmarg_migrator
DB_MIGRATOR_PASSWORD=
DB_SSL=false
DB_LOGGING=false

# --- Redis ---
# Required in production. Locally you may set false (no Docker needed): rate limits use memory, cache is skipped.
# To use it locally later: docker compose up -d redis (from backend/), then set true.
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# --- Auth ---
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh secrets must be different.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token: idle lifetime (extended on each use) and absolute session lifetime.
JWT_REFRESH_EXPIRES_IN=7d
SESSION_MAX_AGE=30d
ADMIN_REFRESH_EXPIRES_IN=1d
ADMIN_SESSION_MAX_AGE=7d
# Signs CSRF tokens for the cookie endpoints. Must differ from the JWT secrets.
CSRF_SECRET=
# 32 random bytes, base64url:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Encrypts 2FA secrets. BACK IT UP OFFLINE: losing it forces every user to re-enrol 2FA.
TWO_FACTOR_ENC_KEY=
# Optional fixed code for /admin/setup (first admin). If empty, one is printed in the server console.
ADMIN_SETUP_CODE=

# --- Frontend URL (used for links in emails; never taken from the request) ---
APP_URL=http://localhost:5173

# --- Email ---
# outbox = save emails as files in backend/.local/outbox (development). smtp = really send (required in production).
MAIL_MODE=outbox
MAIL_FROM=Healthmarg <no-reply@healthmarg.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- reCAPTCHA v3 (off locally; live required in production) ---
RECAPTCHA_MODE=off
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_LOGIN_MIN_SCORE=0.3

# Reject passwords found in known data breaches (only 5 characters of the hash leave the server).
HIBP_ENABLED=true

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
