                "exec": [
                  "pm.test('profile', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user).to.not.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
