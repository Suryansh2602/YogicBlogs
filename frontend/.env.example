# Copy to .env and fill in. Every VITE_ value is PUBLIC: it ends up in the JS bundle.
# Never put passwords, secret tokens or private keys here; the build fails if a name looks like one.
VITE_API_BASE_URL=http://localhost:5000/api/v1
# The site's public address, set for production builds (docs/seo.md). Leave empty locally.
VITE_SITE_URL=
# reCAPTCHA v3 site key (public). Leave empty locally; the API runs with RECAPTCHA_MODE=off.
VITE_RECAPTCHA_SITE_KEY=
# Email features (confirm email, password reset). Keep in step with the API's EMAIL_ENABLED.
VITE_FEATURE_EMAIL=false
